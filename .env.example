# Скопируйте этот файл в .env и заполните под ваш сервер
# cp .env.example .env

APP_NAME="PBX Doc"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

# Часовой пояс для отображения времени в приложении (идентификатор IANA:
# Asia/Novosibirsk, Asia/Omsk, Europe/Moscow, Asia/Yekaterinburg ...)
APP_TIMEZONE=Asia/Novosibirsk

# База данных (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pbxdoc
DB_USERNAME=pbxdoc
DB_PASSWORD=change_me

# Имя cookie сессии
SESSION_NAME=pbxdoc_session

# Максимальный размер файла в справочнике "Музыка", МБ
MUSIC_MAX_UPLOAD_MB=20
